# ── Frontend configuration ──────────────────────────────────────────
# Copy this file to .env.local for local development.
#
#   cp .env.example .env.local
#
# The value below is LOCAL DEV ONLY (browser → backend direct).
# Docker builds default NEXT_PUBLIC_API_URL to "" (same-origin relative
# URLs proxied through nginx — see Dockerfile ARG); pass --build-arg to
# override for cross-origin prod (e.g. https://app.openzync.tech).
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
